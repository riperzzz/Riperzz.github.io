body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #050b16;
  color: #e5e9f0;
}

header {
  padding: 20px;
  background: #0b1c3d;
  border-bottom: 1px solid #1f2a3c;
}

.stats {
  display: flex;
  gap: 15px;
  padding: 20px;
}

.card {
  background: #111827;
  padding: 15px 20px;
  border-radius: 6px;
  border: 1px solid #1f2937;
}
